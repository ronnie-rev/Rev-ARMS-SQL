# Copy to /opt/claimsiq/claimsiq.env and edit. Read by every script in deploy/selfhost/. Never commit the real file.
DOMAIN=example.com                 # the app is served at https://DOMAIN, the API at https://api.DOMAIN
ADMIN_EMAIL=you@example.com        # the FIRST account created becomes Sr. Management (see 30-create-first-admin.sh)
SUPABASE_REF=                      # REQUIRED: the upstream supabase/supabase git tag or commit you tested (do not use "master" in production)
INSTALL_DIR=/opt/claimsiq/supabase
APP_DIR=/var/www/claimsiq/dist
BACKUP_DIR=/srv/backups/claimsiq
BACKUP_AGE_RECIPIENT=              # age public key (age1...) — the PRIVATE key stays offline, NOT on this server
BACKUP_RCLONE_REMOTE=              # optional off-server copy, e.g. "b2:claimsiq-backups" (needs a BAA with that storage provider if backups contain PHI)
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12
SMTP_HOST=                         # transactional email for invites / password resets (these emails carry no PHI)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=ClaimsIQ
